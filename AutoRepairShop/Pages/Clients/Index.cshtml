@page
@model AutoRepairShop.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Список клиентов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">База клиентов</h2>
            <p class="text-muted small mb-0">Всего зарегистрировано: @Model.Clients.Count</p>
        </div>
        <a asp-page="Create" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-person-plus-fill"></i> + Новый клиент
        </a>
    </div>

    <div class="row g-4">
        @foreach (var client in Model.Clients)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm client-card transition-all">
                    <div class="card-body d-flex flex-column p-4">
                        
                        <div class="mb-3">
                            <h5 class="card-title fw-bold text-primary text-truncate mb-1" title="@client.FullName">
                                @client.FullName
                            </h5>
                            <span class="badge bg-light text-secondary border">Клиент СТО</span>
                        </div>

                        <div class="mb-2">
                            <label class="text-uppercase ls-1 fw-bold text-muted mb-1" style="font-size: 0.65rem;">Email</label>
                            <span class="d-block text-truncate small" title="@client.Email">
                                <span class="text-primary opacity-75">✉</span> @client.Email
                            </span>
                        </div>

                        <div class="mb-4">
                            <label class="text-uppercase ls-1 fw-bold text-muted mb-1" style="font-size: 0.65rem;">Телефон</label>
                            <span class="d-block small">
                                <span class="text-success opacity-75">📞</span> 
                                @(string.IsNullOrEmpty(client.NumberPhone) ? "Не указан" : client.NumberPhone)
                            </span>
                        </div>

                        <div class="mt-auto">
                            <div class="d-grid gap-2">
                                <a asp-page="Details" asp-route-id="@client.Id" class="btn btn-sm btn-primary py-2 fw-semibold">
                                    Открыть профиль
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-page="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-warning flex-grow-1 py-2">
                                        Изменить
                                    </a>
                                    <a asp-page="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger flex-grow-1 py-2">
                                        Удалить
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .client-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important;
    }
    
    .transition-all {
        transition: all 0.25s ease-in-out;
    }

    .ls-1 {
        letter-spacing: 0.05rem;
    }

    .card {
        border-radius: 12px;
    }
    
    .btn {
        border-radius: 8px;
    }
</style>
