@page
@model AutoRepairShop.Pages.Clients.CreateModel
@{
}
<h1>Добавить клиента</h1>

<form method="post">
    <div>
        <label>Фамилия и имя</label><br />
        <input asp-for="Client.FullName" />
    </div>

    <div>
        <label>Номер телефона</label><br />
        <input asp-for="Client.NumberPhone" />
    </div>

    <div>
        <label>Email</label><br />
        <input asp-for="Client.Email" />
    </div>

    <div>
        <label>Автомобиль</label><br />
        <input asp-for="Client.Cars" />
    </div>

    <button type="submit">Сохранить</button>
</form>
