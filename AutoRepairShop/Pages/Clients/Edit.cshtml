@page "{id:int}"
@model AutoRepairShop.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Редактирование клиента";
}

<style>
    /* Базовые стили карточки (Светлая тема) */
    .edit-card {
        background-color: #ffffff !important;
        border: 1px solid rgba(0,0,0,0.08) !important;
        border-top: 5px solid #ffc107 !important; /* Желтая полоса для редактирования */
        border-radius: 15px;
        transition: all 0.3s ease;
    }

    .input-group-text {
        background-color: #f8f9fa !important;
        border-color: #dee2e6 !important;
        color: #6c757d;
        transition: all 0.3s ease;
    }

    .form-control {
        background-color: #ffffff !important;
        border-color: #dee2e6 !important;
        color: #212529 !important;
    }

    /* ТЕМНАЯ ТЕМА */
    [data-theme="dark"] .edit-card {
        background-color: #1e1e1e !important;
        border-color: rgba(255,255,255,0.1) !important;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4) !important;
    }

    [data-theme="dark"] .input-group-text {
        background-color: #2b2b2b !important;
        border-color: rgba(255,255,255,0.1) !important;
        color: #adb5bd;
    }

    [data-theme="dark"] .form-control {
        background-color: #252525 !important;
        border-color: rgba(255,255,255,0.1) !important;
        color: #f8f9fa !important;
    }

    /* Вспомогательные классы */
    .text-custom-muted {
        color: #6c757d;
    }

    [data-theme="dark"] .text-custom-muted {
        color: #adb5bd;
    }

    .text-main-bright {
        color: #212529;
    }

    [data-theme="dark"] .text-main-bright {
        color: #f8f9fa !important;
    }
</style>

<div class="container d-flex flex-column align-items-center justify-content-center mt-5">
    <div class="text-center mb-4">
        <i class="bi bi-pencil-square text-warning display-1"></i>
        <h1 class="mt-3 fw-bold text-main-bright">Редактирование профиля</h1>
        <p class="text-custom-muted">Изменение данных клиента <span class="badge bg-warning text-dark">ID: @Model.Client.Id</span></p>
    </div>

    <div class="card shadow-sm p-4 w-100 edit-card" style="max-width: 550px;">
        <form method="post">
            <input type="hidden" asp-for="Client.Id" />
            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label class="form-label text-custom-muted small fw-bold text-uppercase">Полное имя</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0"><i class="bi bi-person"></i></span>
                    <input asp-for="Client.FullName" class="form-control border-start-0" placeholder="Иван Иванов" />
                </div>
                <span asp-validation-for="Client.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label text-custom-muted small fw-bold text-uppercase">Электронная почта</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Client.Email" class="form-control border-start-0" placeholder="example@mail.com" />
                </div>
                <span asp-validation-for="Client.Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label text-custom-muted small fw-bold text-uppercase">Телефон</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0"><i class="bi bi-telephone"></i></span>
                    <input asp-for="Client.NumberPhone" class="form-control border-start-0" placeholder="+7 (999) 000-00-00" />
                </div>
                <span asp-validation-for="Client.NumberPhone" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-warning py-2 fw-bold shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Сохранить изменения
                </button>
                <a asp-page="./Details" asp-route-id="@Model.Client.Id" class="btn btn-outline-secondary py-2 fw-bold">
                    Отмена
                </a>
            </div>
        </form>
    </div>
</div>