@page "{id:int}"
@model AutoRepairShop.Pages.Clients.EditModel

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Редактирование клиента</h5>
            </div>

            <div class="card-body">

                <form method="post">
                    <input type="hidden" asp-for="Client.Id" />

                    <div class="mb-3">
                        <label asp-for="Client.FullName" class="form-label"></label>
                        <input asp-for="Client.FullName" class="form-control" />
                        <span asp-validation-for="Client.FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Client.Email" class="form-label"></label>
                        <input asp-for="Client.Email" class="form-control" />
                        <span asp-validation-for="Client.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Client.NumberPhone" class="form-label"></label>
                        <input asp-for="Client.NumberPhone" class="form-control" />
                        <span asp-validation-for="Client.NumberPhone" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            Назад
                        </a>

                        <button type="submit" class="btn btn-success">
                            Сохранить
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
