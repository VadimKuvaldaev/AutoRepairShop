@page "{id:int}"
@model AutoRepairShop.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Редактирование профиля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            
            <div class="mb-4 text-center">
                <h2 class="fw-bold">Профиль клиента</h2>
                <p class="text-muted">Обновите контактную информацию ниже</p>
            </div>

            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="bg-warning p-2"></div>
                
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <input type="hidden" asp-for="Client.Id" />

                        <div class="mb-4">
                            <label asp-for="Client.FullName" class="form-label fw-semibold text-secondary small text-uppercase ls-1">ФИО Клиента</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">👤</span>
                                <input asp-for="Client.FullName" class="form-control border-start-0 ps-0" placeholder="Иванов Иван Иванович" />
                            </div>
                            <span asp-validation-for="Client.FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Client.Email" class="form-label fw-semibold text-secondary small text-uppercase ls-1">Электронная почта</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">📧</span>
                                <input asp-for="Client.Email" class="form-control border-start-0 ps-0" placeholder="example@mail.com" />
                            </div>
                            <span asp-validation-for="Client.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Client.NumberPhone" class="form-label fw-semibold text-secondary small text-uppercase ls-1">Номер телефона</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">📞</span>
                                <input asp-for="Client.NumberPhone" class="form-control border-start-0 ps-0" placeholder="+7 (999) 000-00-00" />
                            </div>
                            <span asp-validation-for="Client.NumberPhone" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                                Сохранить изменения
                            </button>
                            <a asp-page="Index" class="btn btn-link text-muted text-decoration-none small mt-2">
                                ← Вернуться к списку без сохранения
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <span class="badge bg-light text-secondary border">Системный ID: @Model.Client.Id</span>
            </div>

        </div>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 0.5px; }
    .form-control:focus {
        box-shadow: none;
        border-color: #dee2e6;
        background-color: #fff;
    }
    .input-group-text {
        border-color: #dee2e6;
    }
    .form-control {
        border-color: #dee2e6;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}