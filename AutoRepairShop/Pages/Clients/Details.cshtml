@page "{id:int}"
@model AutoRepairShop.Pages.Clients.DetailsModel
@{
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Информация о клиенте</h5>
            </div>

            <div class="card-body">

                <dl class="row mb-0">
                    <dt class="col-sm-4">Фамилия</dt>
                    <dd class="col-sm-8">@Model.Client.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Client.Email</dd>

                    <dt class="col-sm-4">Номер телефона</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Client.NumberPhone)
                                                ? "—" 
                                                        : Model.Client.NumberPhone)
                    </dd>
                </dl>

            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-page="Index" class="btn btn-outline-secondary">
                    Назад
                </a>

                <div>
                    <a asp-page="Edit"
                       asp-route-id="@Model.Client.Id"
                       class="btn btn-warning me-2">
                        Редактировать
                    </a>

                    <a asp-page="Delete"
                       asp-route-id="@Model.Client.Id"
                       class="btn btn-danger">
                        Удалить
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
