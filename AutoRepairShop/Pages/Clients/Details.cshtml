@page
@model AutoRepairShop.Pages.Clients.DetailsModel
@{
    ViewData["Title"] = "Профиль клиента";
}

<style>
    .details-card, .car-item-card {
        transition: all 0.3s ease;
        border-radius: 15px;
        overflow: hidden;
    }

    .details-card {
        background-color: #ffffff !important;
        border: 1px solid rgba(0,0,0,0.08) !important;
    }

    .profile-header {
        background: #0dcaf0; 
        color: white;
        padding: 1.5rem;
    }

    .id-badge {
        background-color: rgba(255, 255, 255, 0.9);
        color: #000 !important;
        font-weight: bold;
        padding: 0.5em 0.8em;
        border-radius: 6px;
    }

    .car-item-card {
        background-color: #f8f9fa;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .footer-actions {
        background-color: #f8f9fa;
        border-top: 1px solid rgba(0,0,0,0.05);
    }

    [data-theme="dark"] .details-card {
        background-color: #1e1e1e !important;
        border-color: rgba(255,255,255,0.1) !important;
    }

    [data-theme="dark"] .profile-header {
        background: #087990; 
    }

    [data-theme="dark"] .id-badge {
        background-color: rgba(0, 0, 0, 0.3) !important;
        color: #fff !important;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    [data-theme="dark"] .car-item-card {
        background-color: rgba(255,255,255,0.03);
        border-color: rgba(255,255,255,0.1);
    }

    [data-theme="dark"] .footer-actions {
        background-color: rgba(0,0,0,0.2);
        border-color: rgba(255,255,255,0.1);
    }

    .text-custom-muted {
        color: #6c757d;
    }

    [data-theme="dark"] .text-custom-muted {
        color: #adb5bd;
    }

    [data-theme="dark"] .text-main-bright {
        color: #f8f9fa !important;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0 mb-4 details-card">
                <div class="profile-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-vcard me-2"></i>Карточка клиента</h4>
                    <span class="badge id-badge">ID: @Model.Client.Id</span>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-circle display-4 text-primary opacity-50"></i>
                    </div>
                    <h2 class="fw-bold text-main-bright">@Model.Client.FullName</h2>
                    <div class="d-flex justify-content-center gap-3">
                        <p class="text-custom-muted mb-0"><i class="bi bi-telephone text-primary me-2"></i>@Model.Client.NumberPhone</p>
                        @if (!string.IsNullOrEmpty(Model.Client.Email))
                        {
                            <p class="text-custom-muted mb-0"><i class="bi bi-envelope text-primary me-2"></i>@Model.Client.Email</p>
                        }
                    </div>
                </div>

                <div class="footer-actions p-3 d-flex gap-2">
                    <a asp-page="./Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning flex-grow-1 fw-bold">
                        <i class="bi bi-pencil-square me-1"></i> Изменить
                    </a>
                    <a asp-page="./Index" class="btn btn-outline-secondary flex-grow-1 fw-bold">
                        <i class="bi bi-arrow-left me-1"></i> К списку
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0 details-card">
                <div class="card-header bg-transparent pt-4 border-0">
                    <h5 class="fw-bold text-main-bright px-2">Автомобили владельца</h5>
                </div>
                <div class="card-body">
                    @if (Model.Client.Cars != null && Model.Client.Cars.Any())
                    {
                        <div class="row g-3">
                            @foreach (var car in Model.Client.Cars)
                            {
                                <div class="col-12">
                                    <div class="car-item-card p-3 d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 me-3">
                                                <i class="bi bi-car-front-fill fs-4"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-main-bright">@car.Brand @car.ModelCar</h6>
                                                <small class="text-custom-muted">Год выпуска: @car.Year</small>
                                            </div>
                                        </div>
                                        <a asp-page="/Cars/Details" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                            Детали <i class="bi bi-chevron-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-custom-muted">
                            <i class="bi bi-info-circle d-block fs-1 mb-2 opacity-25"></i>
                            <p class="mb-0">У этого клиента пока нет добавленных авто.</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>