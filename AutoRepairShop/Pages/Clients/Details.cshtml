@page "{id:int}"
@model AutoRepairShop.Pages.Clients.DetailsModel
@{
    ViewData["Title"] = "Профиль клиента";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-7">

            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-decoration-none">Клиенты</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Детали профиля</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="bg-primary bg-gradient p-4 text-white">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center shadow-sm"
                             style="width: 64px; height: 64px; font-size: 1.5rem;">
                            @Model.Client.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <div class="ms-3">
                            <h3 class="mb-0 fw-bold">@Model.Client.FullName</h3>
                            <span class="badge bg-white text-primary opacity-75">Постоянный клиент</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <label class="text-uppercase small fw-bold text-muted ls-1 d-block mb-1">Электронная почта</label>
                            <p class="fs-5 text-dark">
                                <span class="me-2">📧</span>
                                <a href="mailto:@Model.Client.Email" class="text-decoration-none text-dark">@Model.Client.Email</a>
                            </p>
                        </div>

                        <div class="col-sm-6">
                            <label class="text-uppercase small fw-bold text-muted ls-1 d-block mb-1">Телефон для связи</label>
                            <p class="fs-5 text-dark">
                                <span class="me-2">📞</span>
                                @(string.IsNullOrEmpty(Model.Client.NumberPhone) ? "—" : Model.Client.NumberPhone)
                            </p>
                        </div>

                        <div class="col-12 mt-4">
                            <div class="p-3 bg-light rounded-3 border-start border-primary border-4">
                                <h6 class="fw-bold mb-1">Заметки администратора</h6>
                                <p class="small text-muted mb-0">Клиент предпочитает связь через мессенджеры. Последнее обслуживание пройдено успешно.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-4 border-top-0 d-flex flex-column flex-sm-row justify-content-between gap-2">
                    <a asp-page="Index" class="btn btn-outline-secondary px-4">
                        ← Назад к списку
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning px-4 fw-semibold">
                            Редактировать
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.Client.Id" class="btn btn-outline-danger px-4">
                            Удалить
                        </a>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h5 class="fw-bold mb-3">Привязанные автомобили</h5>
                <div class="card border-0 shadow-sm p-4 text-center">
                    <p class="text-muted mb-0 small">В данный момент за этим клиентом не закреплено ни одного транспортного средства.</p>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .ls-1 {
        letter-spacing: 0.05rem;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
    }

    .card {
        border-radius: 1rem;
    }

    .bg-gradient {
        background: linear-gradient(45deg, #0d6efd, #0dcaf0);
    }
</style>