@page
@model AutoRepairShop.Pages.Account.User.EditModel
@{
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="h3 card-title mb-4 text-warning">Изменить пользователя</h2>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="User.Id" />

                        <div class="mb-3">
                            <label asp-for="User.Email" class="form-label fw-semibold">Email адрес</label>
                            <input asp-for="User.Email" class="form-control" />
                            <span asp-validation-for="User.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.Password" class="form-label fw-semibold">Пароль</label>
                            <input asp-for="User.Password" type="password" class="form-control" />
                            <span asp-validation-for="User.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="User.Role" class="form-label fw-semibold">Роль доступа</label>
                            <select asp-for="User.Role" class="form-select">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                            <span asp-validation-for="User.Role" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning rounded-pill px-4 text-white">Сохранить</button>
                            <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
