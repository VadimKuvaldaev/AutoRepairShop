@page "{id:int}"
@model AutoRepairShop.Pages.Cars.DeleteModel
@{
}
<h1>Удалить автомобиль</h1>

<h3>Вы уверены?</h3>

<div>
    <p><strong>@Model.Car.Brand</strong></p>
    <p>@Model.Car.ModelCar</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Car.Id" />
    <button type="submit">Удалить</button>
</form>

<a asp-page="Index">Отмена</a>
