@page
@model AutoRepairShop.Pages.Cars.IndexModel
@{
}
<h1>Список автомобилей</h1>

<p>
    <a asp-page="Create">Добавить новый автомобиль</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Марка</th>
            <th>Модель</th>
            <th>Номер модели</th>
            <th>Год</th>
            <th>Владелец</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model.Cars)
        {
            <tr>
                <td>@car.Brand.Name</td>
                <td>@car.ModelCar</td>
                <td>@car.ModelID</td>
                <td>@car.Year</td>
                <td>@car.Owner</td>
                <td>
                    <a asp-page="Details" asp-route-id="@car.Id">Открыть</a>
                    <a asp-page="Edit" asp-route-id="@car.Id">Изменить</a>
                    <a asp-page="Delete" asp-route-id="@car.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
