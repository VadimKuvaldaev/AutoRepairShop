@page
@model AutoRepairShop.Pages.Cars.IndexModel
@{
    ViewData["Title"] = "Список авто";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список книг</h2>
        <a asp-page="Create" class="btn btn-success">
            Добавить новый автомобиль
        </a>
    </div>

    <div class="row g-4">
        @foreach (var car in Model.Cars)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title text-truncate">
                             @car.Brand
                        </h5>

                        <p class="card-text text-muted mb-1">
                            Модель: @car.ModelCar
                        </p>

                        <p class="card-text mb-1">
                            Год: <span class="badge bg-secondary">@car.Year</span>
                        </p>

                        <p class="card-text mb-2">
                            Владелец: <span class="badge bg-info">@car.Client.Name</span>
                        </p>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@car.Id" class="btn btn-sm btn-info">
                                Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-warning">
                                Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-danger">
                                Удалить
                            </a>
                        </div>

                    </div>

                </div>

            </div>
        }
    </div>

</div>
