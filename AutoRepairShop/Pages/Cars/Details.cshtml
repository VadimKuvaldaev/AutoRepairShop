@page "{id:int}"
@model AutoRepairShop.Pages.Cars.DetailsModel
@{
    ViewData["Title"] = "Детали автомобиля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-7">

            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="Index" class="text-decoration-none">Автопарк</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Car.Brand.Name @Model.Car.ModelCar</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="bg-dark p-4 text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="rounded-3 bg-primary p-3 me-3 shadow-sm">
                                <span class="fs-2">🚗</span>
                            </div>
                            <div>
                                <h2 class="mb-0 fw-bold">@Model.Car.Brand.Name</h2>
                                <p class="mb-0 text-white-50 fs-5">@Model.Car.ModelCar</p>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-outline-light border border-light px-3 py-2">@Model.Car.Year г.в.</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        <div class="col-12">
                            <h6 class="text-uppercase fw-bold text-muted ls-1 mb-3">Технические характеристики</h6>
                            <div class="row bg-light rounded-3 p-3 g-3 mx-0">
                                <div class="col-6 col-sm-4">
                                    <small class="text-muted d-block">Марка</small>
                                    <span class="fw-semibold">@Model.Car.Brand.Name</span>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <small class="text-muted d-block">Модель</small>
                                    <span class="fw-semibold">@Model.Car.ModelCar</span>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <small class="text-muted d-block">Год выпуска</small>
                                    <span class="fw-semibold">@Model.Car.Year год</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-5">
                            <h6 class="text-uppercase fw-bold text-muted ls-1 mb-3">Информация о владельце</h6>
                            <div class="card border border-light shadow-none">
                                <div class="card-body d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                            👤
                                        </div>
                                        <div>
                                            <p class="mb-0 fw-bold text-dark">@Model.Car.Client.FullName</p>
                                            <small class="text-muted">Зарегистрированный клиент</small>
                                        </div>
                                    </div>
                                    <a asp-page="/Clients/Details" asp-route-id="@Model.Car.Client.Id" class="btn btn-sm btn-outline-primary px-3">
                                        Профиль
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-4 border-top-0 d-flex flex-column flex-sm-row justify-content-between gap-2">
                    <a asp-page="Index" class="btn btn-outline-secondary px-4">
                        ← К списку авто
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-page="Edit" asp-route-id="@Model.Car.Id" class="btn btn-warning px-4 fw-semibold">
                            Редактировать
                        </a>
                        <a asp-page="Delete" asp-route-id="@Model.Car.Id" class="btn btn-outline-danger px-4 text-uppercase fw-bold" style="font-size: 0.75rem;">
                            Удалить
                        </a>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border-0 shadow-sm mt-4 p-4">
                <div class="d-flex align-items-start">
                    <span class="me-3 fs-4">📋</span>
                    <div>
                        <h6 class="fw-bold mb-1">История ремонтов</h6>
                        <p class="small text-muted mb-0">Здесь будет отображаться список всех заказ-нарядов, выполненных для данного автомобиля.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .ls-1 {
        letter-spacing: 0.05rem;
    }

    .card {
        border-radius: 1rem;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
    }

    .bg-dark {
        background-color: #1a1d20 !important;
    }
</style>