@page "{id:int}"
@model AutoRepairShop.Pages.Cars.EditModel
@{
    ViewData["Title"] = "Редактирование автомобиля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="mb-4 text-center">
                <h2 class="fw-bold">Карточка автомобиля</h2>
                <p class="text-muted">Обновите технические данные транспортного средства</p>
            </div>

            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="bg-warning p-2"></div>

                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <input type="hidden" asp-for="Car.Id" />

                        <div class="row">
                            <div class="col-md-7 mb-4">
                                <label asp-for="Car.Brand" class="form-label fw-semibold text-secondary small text-uppercase ls-1">Марка</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">🏢</span>
                                    <input asp-for="Car.Brand.Name" class="form-control border-start-0 ps-0" placeholder="Например: Toyota" />
                                </div>
                                <span asp-validation-for="Car.Brand" class="text-danger small"></span>
                            </div>

                            <div class="col-md-5 mb-4">
                                <label asp-for="Car.Year" class="form-label fw-semibold text-secondary small text-uppercase ls-1">Год выпуска</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">📅</span>
                                    <input asp-for="Car.Year" type="number" class="form-control border-start-0 ps-0" placeholder="2020" />
                                </div>
                                <span asp-validation-for="Car.Year" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Car.ModelCar" class="form-label fw-semibold text-secondary small text-uppercase ls-1">Модель</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">🚗</span>
                                <input asp-for="Car.ModelCar" class="form-control border-start-0 ps-0" placeholder="Например: Camry" />
                            </div>
                            <span asp-validation-for="Car.ModelCar" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Car.Client" class="form-label fw-semibold text-secondary small text-uppercase ls-1">Владелец</label>
                            <div class="input-group shadow-sm-hover transition-all">
                                <span class="input-group-text bg-light border-end-0 text-muted">👤</span>
                                <select asp-for="Car.Client.Name" asp-items="Model.ClientList" class="form-select border-start-0 ps-0">
                                    <option value="">-- Выберите владельца --</option>
                                </select>
                            </div>
                            <span asp-validation-for="Car.Client" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold py-3">
                                Сохранить изменения
                            </button>
                            <a asp-page="Index" class="btn btn-link text-muted text-decoration-none small mt-2">
                                ← Отмена (Вернуться к списку)
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3">
                <span class="badge bg-light text-secondary border fw-normal">ID автомобиля: #@Model.Car.Id</span>
            </div>

        </div>
    </div>
</div>

<style>
    .ls-1 {
        letter-spacing: 0.5px