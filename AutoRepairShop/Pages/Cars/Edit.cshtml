@page "{id:int}"
@model AutoRepairShop.Pages.Cars.EditModel
@{
}
<h1>Редактировать автомобиль</h1>

<form method="post">
    <input type="hidden" asp-for="Car.Id" />

    <div>
        <label>Марка</label><br />
        <input asp-for="Car.Brand.Name" />
    </div>

    <div>
        <label>Модель</label><br />
        <input asp-for="Car.ModelCar" />
    </div>

    <div>
        <label>Номер модели</label><br />
        <input asp-for="Car.ModelID" type="number" />
    </div>

    <div>
        <label>Год</label><br />
        <input asp-for="Car.Year" type="number" />
    </div>

    <div>
        <label>Владелец</label><br />
        <input asp-for="Car.Owner" />
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>
